{
  "name": "@sbkolate/forge",
  "version": "0.1.0",
  "description": "Node.js SDK for corebrain MCP server",
  "license": "MIT",
  "author": "Sambhaji Kolate <erp@sbknext.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "ai",
    "brain",
    "corebrain",
    "forge",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbknext/forge-client.git"
  },
  "bugs": {
    "url": "https://github.com/sbknext/forge-client/issues"
  },
  "homepage": "https://github.com/sbknext/forge-client#readme"
}
